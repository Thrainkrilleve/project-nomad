# Copy this file to `.env` next to your compose file and fill in the values.
# Never commit `.env`. The Linux installer writes one at /opt/project-nomad/.env
# with mode 0600.

# Host address published ports bind to. 127.0.0.1 (default) is localhost only.
# Set 0.0.0.0 to listen on all interfaces, then put a reverse proxy with TLS
# and authentication in front. Do not expose Command Center to the internet.
NOMAD_BIND_ADDR=127.0.0.1

# Install root on the host (compose file, Linux mysql/redis data, updater mount).
NOMAD_HOME=/opt/project-nomad

# Host path bind-mounted as /app/storage in the admin container.
NOMAD_STORAGE_HOST=/opt/project-nomad/storage

# Storage path as the Docker daemon (and child containers) should see it.
# On Linux this matches NOMAD_STORAGE_HOST. On Docker Desktop for Windows it is
# typically /run/desktop/mnt/host/<drive>/<path>, for example
# /run/desktop/mnt/host/d/nomad/storage.
NOMAD_STORAGE_CONTAINER=/opt/project-nomad/storage

# Public URL you use to open Command Center. Must match how you reach it.
URL=http://127.0.0.1:8080

# Required secrets. Replace every placeholder with a unique random value.
# APP_KEY must be at least 16 characters. MYSQL_PASSWORD must match DB_PASSWORD.
APP_KEY=change-me-at-least-16-characters
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me

# Optional. Path to this repository's root, used only when building the admin
# image from source with install/compose.windows.override.yml. Relative paths
# are resolved from the override file's directory (install/). Leave unset
# (default ..) when you run Compose from a clone of this repo.
# NOMAD_BUILD_CONTEXT=..
